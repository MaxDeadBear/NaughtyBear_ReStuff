+// LOCAL PATCH (M4.16 parity): codegen-time env REX_EMIT_FMA=1 emits FUSED
+// multiply-add for vmaddfp/vnmsubfp (real VMX fuses: one rounding, not two).
+// The consuming project must compile recompiled TUs with FMA3 available
+// (e.g. -mfma) or simde silently falls back to the unfused pair.
+static bool emit_fused_fma() {
+  static const bool fused = [] {
+    const char* e = std::getenv("REX_EMIT_FMA");
+    return e && e[0] == '1';
+  }();
+  return fused;
+}
