+set(REXGLUE_CODEGEN_CLI "$<TARGET_FILE:rex::rexglue>" CACHE STRING
+    "rexglue CLI used for in-build codegen (must be host-runnable)")
+set(REXGLUE_CODEGEN_ENV "" CACHE STRING
